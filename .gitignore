# Xcode build output
build/
DerivedData/
*.xcarchive

# User-specific Xcode settings
*.xcuserstate
xcuserdata/
*.xcworkspace/xcuserdata/

# CocoaPods
Pods/

# Swift Package Manager
.build/
*.resolved

# macOS
.DS_Store

# API keys / secrets — never commit these
*.plist.bak
Secrets.swift
APIKeys.swift
SecretsStore.swift

# Note: *.storekit is intentionally NOT ignored — it holds no secrets
# (just product IDs/prices) and the shared Xcode scheme references it
# directly, so it must be committed for StoreKit Testing to work on a
# fresh clone.

# Internal planning/engineering docs — kept locally for reference, not
# pushed to GitHub. The public-facing docs are README.md at the repo root
# and docs/privacy.html; both stay tracked.
docs/README.md
docs/ARCHITECTURE.md
docs/DECISIONS.md
docs/CHANGELOG.md
docs/APPLE_REVIEW.md
docs/ROADMAP.md
docs/SECURITY.md
docs/MARKETING.md
docs/WHITEPAPER.md

# Agent instructions — kept locally only, not pushed to GitHub
CLAUDE.md
.claude/
.superpowers/

# Internal design specs / planning docs — local-only
docs/superpowers/

# Google Drive staging dirs. The Drive client recreates these on its own
# inside synced folders; they are its scratch space, never project content.
.tmp.driveupload
.tmp.drivedownload
